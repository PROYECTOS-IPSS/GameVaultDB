<section class="py-5">
  <div class="container">
    <div class="row g-4">
      <aside class="col-lg-3">
        <div class="position-sticky" style="top: 80px;">
          {{> sidebar}}
        </div>
      </aside>
      
      <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h2 class="mb-0">Todos los juegos</h2>
            <p class="text-secondary mb-0">{{games.length}} juegos disponibles</p>
          </div>
          <a href="/games/new" class="btn btn-danger">
            <i class="bi bi-plus-lg me-2"></i>Añadir juego
          </a>
        </div>

        <div class="row g-4">
          {{#each games}}
          <div class="col-md-6 col-xl-4">
            {{> game-card this}}
          </div>
          {{else}}
          <div class="col-12 text-center py-5">
            <i class="bi bi-search display-1 text-secondary"></i>
            <p class="text-secondary mt-3">No se encontraron juegos</p>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>
</section>
