<form method="GET" action="/games" class="sidebar-sticky">
  <h6 class="text-uppercase text-secondary small fw-semibold mb-3">Filtros</h6>
  
  <div class="mb-4">
    <label class="form-label small text-secondary">Plataforma</label>
    <select name="platformId" class="form-select form-select-sm bg-dark text-light border-secondary">
      <option value="">Todas</option>
      {{#each platforms}}
      <option value="{{this.id}}" {{#if (eq this.id ../filters.platformId)}}selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>

  <div class="mb-4">
    <label class="form-label small text-secondary">Género</label>
    <select name="genreId" class="form-select form-select-sm bg-dark text-light border-secondary">
      <option value="">Todos</option>
      {{#each genres}}
      <option value="{{this.id}}" {{#if (eq this.id ../filters.genreId)}}selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>

  <div class="mb-4">
    <label class="form-label small text-secondary">Precio máximo: $<span id="maxPriceValue">{{filters.maxPrice}}</span></label>
    <input type="range" id="maxPriceRange" name="maxPrice" class="form-range" min="0" max="{{catalogMaxPrice}}" value="{{filters.maxPrice}}">
  </div>

  <button type="submit" class="btn btn-danger w-100 btn-sm">
    <i class="bi bi-funnel me-2"></i>Aplicar filtros
  </button>
</form>

<script>
  document.getElementById('maxPriceRange').addEventListener('input', function(e) {
    document.getElementById('maxPriceValue').textContent = e.target.value;
  });
</script>
