<section class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="mb-0">Mi Colección</h2>
        <p class="text-secondary mb-0">{{games.length}} juegos en tu colección</p>
      </div>
      <a href="/games" class="btn btn-outline-light">
        <i class="bi bi-plus-circle me-2"></i>Explorar juegos
      </a>
    </div>

    {{#if games.length}}
    <div class="row g-4">
      {{#each games}}
      <div class="col-md-6 col-lg-4">
        <div class="card game-card bg-dark border-secondary h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <span class="badge bg-danger text-uppercase small">{{this.genre.name}}</span>
              <span class="text-secondary small">{{this.platform.name}}</span>
            </div>
            <h5 class="card-title mb-2">{{this.title}}</h5>
            <p class="card-text text-secondary small mb-3">{{this.description}}</p>
            <div class="d-flex justify-content-between align-items-center">
              <span class="h5 mb-0 text-danger">${{this.price}}</span>
              <div class="d-flex gap-2">
                <form action="/collection/{{this.id}}/remove" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash me-1"></i>Quitar
                  </button>
                </form>
                <a href="/games/{{this.id}}" class="btn btn-outline-light btn-sm">
                  <i class="bi bi-eye me-1"></i>Ver
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="text-center py-5">
      <i class="bi bi-collection display-1 text-secondary"></i>
      <h3 class="mt-3">Tu colección está vacía</h3>
      <p class="text-secondary">Explora juegos y añade los que más te gusten a tu colección personal.</p>
      <a href="/games" class="btn btn-danger btn-lg mt-3">
        <i class="bi bi-search me-2"></i>Explorar juegos
      </a>
    </div>
    {{/if}}
  </div>
</section>
