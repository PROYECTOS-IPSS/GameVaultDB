<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="card bg-dark border-secondary">
          <div class="card-body p-4">
            <h1 class="h3 mb-1">Crear cuenta</h1>
            <p class="text-secondary mb-4">Regístrate para administrar la colección</p>

            {{#if error}}
            <div class="alert alert-danger" role="alert">{{error}}</div>
            {{/if}}

            {{#if errors.length}}
            <ul class="alert alert-warning">
              {{#each errors}}
              <li>{{this.message}}</li>
              {{/each}}
            </ul>
            {{/if}}

            <form action="/auth/register" method="POST" novalidate>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label" for="nombre">Nombre</label>
                  <input
                    id="nombre"
                    type="text"
                    name="nombre"
                    value="{{values.nombre}}"
                    class="form-control bg-dark text-light border-secondary"
                    required
                  >
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="apellido">Apellido</label>
                  <input
                    id="apellido"
                    type="text"
                    name="apellido"
                    value="{{values.apellido}}"
                    class="form-control bg-dark text-light border-secondary"
                    required
                  >
                </div>
                <div class="col-12">
                  <label class="form-label" for="email">Email</label>
                  <input
                    id="email"
                    type="email"
                    name="email"
                    value="{{values.email}}"
                    class="form-control bg-dark text-light border-secondary"
                    required
                    autocomplete="email"
                  >
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="password">Contraseña</label>
                  <input
                    id="password"
                    type="password"
                    name="password"
                    class="form-control bg-dark text-light border-secondary"
                    required
                    autocomplete="new-password"
                    minlength="8"
                  >
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="confirmPassword">Confirmar contraseña</label>
                  <input
                    id="confirmPassword"
                    type="password"
                    name="confirmPassword"
                    class="form-control bg-dark text-light border-secondary"
                    required
                    autocomplete="new-password"
                    minlength="8"
                  >
                </div>
                <div class="col-12 d-grid mt-2">
                  <button type="submit" class="btn btn-danger">
                    <i class="bi bi-person-plus me-2"></i>Registrarse
                  </button>
                </div>
              </div>
            </form>

            <p class="text-secondary mb-0 text-center mt-3">
              ¿Ya tienes cuenta?
              <a href="/auth/login" class="link-danger text-decoration-none">Ingresa</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
