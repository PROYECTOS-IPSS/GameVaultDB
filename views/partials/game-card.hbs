<div class="card game-card bg-dark border-secondary h-100">
  <div class="card-body d-flex flex-column">
    <div class="d-flex justify-content-between align-items-start mb-2">
      <span class="badge bg-danger text-uppercase small">{{this.genre.name}}</span>
      <span class="text-secondary small">{{this.platform.name}}</span>
    </div>
    <h5 class="card-title mb-2">{{this.title}}</h5>
    <p class="card-text text-secondary small mb-3 flex-grow-1">{{this.description}}</p>
    <div class="d-flex justify-content-between align-items-center mt-auto">
      <span class="h5 mb-0 text-danger">${{this.price}}</span>
      <div class="d-flex gap-2">
        {{#if @root.user}}
          {{#if this.isInCollection}}
          <form action="/collection/{{this.id}}/remove" method="POST" class="d-inline">
            <button type="submit" class="btn btn-success btn-sm d-flex align-items-center">
              <i class="bi bi-check-circle me-1"></i>En colección
            </button>
          </form>
          {{else}}
          <form action="/collection/{{this.id}}/add" method="POST" class="d-inline">
            <button type="submit" class="btn btn-outline-success btn-sm">
              <i class="bi bi-plus-circle me-1"></i>Añadir
            </button>
          </form>
          {{/if}}
        {{/if}}
        <a href="/games/{{this.id}}" class="btn btn-outline-light btn-sm">
          <i class="bi bi-eye me-1"></i>Ver
        </a>
      </div>
    </div>
  </div>
</div>
